{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PromptFlow",
  "version": "2.0.0",
  "identifier": "io.github.tugberkup.promptflow",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "PromptFlow",
        "width": 480,
        "height": 760,
        "minWidth": 440,
        "minHeight": 600,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  }
}
